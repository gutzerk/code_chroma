# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Used by codechroma.summarize.ai_summarizer.AISummarizer for node summaries and grouping labels,
# and by codechroma.context.c1_generator for the one-time C1 (system-context) diagram bootstrap.
# Optional: engine falls back to deterministic offline summaries when unset, and the bridge skips
# C1 bootstrap generation (use the codechroma-draw-diagram skill to write .codechroma/c1.json by hand).
ANTHROPIC_API_KEY=
