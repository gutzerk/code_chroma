# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock

# codechroma persisted graphs
.codechroma/

# Skills the bridge syncs into examples/ when it is dogfooded as an analyzed repo
examples/.claude/


# Node.js (web/)
node_modules/
playwright-report/
test-results/
*.tsbuildinfo

# IDE
.idea/
.DS_Store

# Claude Code harness runtime state (session-specific, not project source)
.claude/scheduled_tasks.lock

# Per-checkout active-feature pointer for /speckit-* commands -- diverges per branch/worktree,
# not shared repo state, so tracking it just produces merge conflicts.
.specify/feature.json

# Throwaway single-page previews of a diagram change (e.g. epics-preview.html).
epics-preview.html
*-preview.html

# Scratch/temp output from diagram preview tooling (HTML/PNG builds, ad-hoc playwright probes).
.claude/tmp/
.claude/plans/
.claude/reports/
# Installed copies of the skills in skills/ (the bridge syncs them into every opened project)
.claude/skills/codechroma-*/
verify_tmp*.cjs

# .NET build output (dotnet/)
dotnet/**/bin/
dotnet/**/obj/
dotnet/**/TestResults/
