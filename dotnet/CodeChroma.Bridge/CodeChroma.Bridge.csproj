<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../tests/fixtures/bridge_contract/llm_catalog.json" LogicalName="llm_catalog.json" />
    <EmbeddedResource Include="../../src/codechroma/diagrams/kinds.json" LogicalName="diagram_kinds.json" />
    <EmbeddedResource Include="../../src/codechroma/bridge/agents/detect/*.toml" LogicalName="detect/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../src/codechroma/prompts/*.yaml" LogicalName="prompts/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../skills/**/*" Exclude="../../skills/**/__pycache__/**" Link="skills/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CodeChroma.Core/CodeChroma.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

</Project>
