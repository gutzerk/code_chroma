<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CodeChroma.Shell.App.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" RegionColor="#11131a" Accent="#6c8cff" BaseHigh="#e6e9f0" BaseMedium="#8b93a7" ChromeLow="#2a3040" ErrorText="IndianRed" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <!-- Mirrors the launcher and tab bar CSS of the Electron shell: bg #11131a, panel #191d28, line #2a3040, accent #6c8cff, rounded 7-10px. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI, SF Pro Text, Helvetica Neue, Cantarell, Ubuntu, Noto Sans, DejaVu Sans, sans-serif" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#2a3040" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="18,8" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#212736" />
      <Setter Property="BorderBrush" Value="#2a3040" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2a3042" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#6c8cff" />
      <Setter Property="BorderBrush" Value="#6c8cff" />
      <Setter Property="Foreground" Value="#0b0e16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#8099ff" />
      <Setter Property="BorderBrush" Value="#8099ff" />
      <Setter Property="TextElement.Foreground" Value="#0b0e16" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6c8cff" />
      <Setter Property="TextElement.Foreground" Value="#0b0e16" />
    </Style>
    <Style Selector="Button.tutorial">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="20,11" />
    </Style>
    <Style Selector="Button.flat">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,11" />
    </Style>
    <Style Selector="Button.tiny">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Foreground" Value="#8b93a7" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="#191d28" />
      <Setter Property="BorderBrush" Value="#2a3040" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#6c8cff" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
      <Setter Property="Background" Value="#191d28" />
      <Setter Property="BorderBrush" Value="#2a3040" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#191d28" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
  </Application.Styles>
</Application>
