    {
      "id": "a_shell_agent_runs_survives_a_window_closing_and_stops_on_request",
      "requires": [
        "pty"
      ],
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "Live",
              "kind": "shell",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/live/start",
            "json": {}
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.status",
                "equals": "idle"
              },
              {
                "path": "$.pid",
                "type": "number"
              }
            ]
          }
        },
        {
          "ws": "connect",
          "name": "win",
          "path": "/ws/terminal?agent=shell&workspace=live",
          "expect": "accepted"
        },
        {
          "ws": "receive",
          "name": "win",
          "tag": "o",
          "raw": true,
          "timeout_ms": 15000
        },
        {
          "ws": "send",
          "name": "win",
          "json": {
            "type": "resize",
            "rows": 30,
            "cols": 100
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/agents"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.agents[0].status",
                "equals": "idle"
              }
            ]
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/live/stop"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.status",
                "equals": "stopped"
              },
              {
                "path": "$.pid",
                "equals": null
              }
            ]
          }
        }
      ]
    },
    {
      "id": "agent_hook_reports_need_that_agents_own_token",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "Hooked",
              "kind": "shell",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/hooked/hook",
            "json": {
              "hook_event_name": "Stop"
            }
          },
          "expect": {
            "status": 401,
            "json": {
              "detail": "invalid or missing workspace token"
            }
          }
        },
        {
          "token": "other",
          "as": "foreign"
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/hooked/hook",
            "json": {
              "hook_event_name": "Stop"
            },
            "headers": {
              "Authorization": "Bearer {{foreign}}"
            }
          },
          "expect": {
            "status": 401,
            "json": {
              "detail": "invalid or missing workspace token"
            }
          }
        },
        {
          "token": "hooked",
          "as": "tok"
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/hooked/hook",
            "json": {
              "hook_event_name": "Stop"
            },
            "headers": {
              "Authorization": "Bearer {{tok}}"
            }
          },
          "expect": {
            "status": 200,
            "json": {
              "ok": true
            }
          }
        },
        {
          "token": "nope",
          "as": "ghost"
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/nope/hook",
            "json": {
              "hook_event_name": "Stop"
            },
            "headers": {
              "Authorization": "Bearer {{ghost}}"
            }
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        }
      ]
    },
    {
      "id": "seen_dismiss_error_and_permission_on_a_stopped_agent",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "Quiet",
              "kind": "shell",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/quiet/seen"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
