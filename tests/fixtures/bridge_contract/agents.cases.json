{
  "group": "agents",
  "sources": [
    "src/codechroma/bridge/agents/live_status.py",
    "src/codechroma/bridge/agents/manager.py",
    "src/codechroma/bridge/routes/agents.py"
  ],
  "repo": {
    "base": "sample_repo"
  },
  "cases": [
    {
      "id": "no_agents_at_first",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/agents"
          },
          "expect": {
            "status": 200,
            "json": {
              "agents": [],
              "active_workspace": "main",
              "max_agents": 5
            }
          }
        }
      ]
    },
    {
      "id": "git_preflight_reports_a_ready_repository",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/agents/git-preflight"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.state",
                "equals": "ready"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "create_validation_is_a_400_with_a_reason",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": 5
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "title must be a string"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "kind": "bogus"
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "unknown agent kind: bogus"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "attach_to": 3
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "attach_to must be a string"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "context": 3
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "context must be a string"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "context_kind": "nope"
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "context_kind must be 'view' or 'task'"
            }
          }
        }
      ]
    },
    {
      "id": "creating_an_agent_needs_a_tab_and_never_attaches_to_main",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "x",
              "kind": "shell"
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "workspace is required"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "x",
              "kind": "shell",
              "attach_to": "main",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "agents cannot attach to main"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "x",
              "kind": "shell",
              "workspace": "br_nope"
            }
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown workspace: br_nope"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "x",
              "kind": "shell",
              "workspace": "main"
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "workspace must be a worktree tab id, not 'main'"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "x",
              "kind": "shell",
              "workspace": 5
            }
          },
          "expect": {
            "status": 400,
            "json": {
              "detail": "workspace must be a string"
            }
          }
        }
      ]
    },
    {
