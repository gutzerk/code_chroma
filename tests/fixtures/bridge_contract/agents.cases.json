              "title": "x",
              "kind": "shell",
              "attach_to": "nope",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown attach_to: nope"
            }
          }
        }
      ]
    },
    {
      "id": "unknown_agents_are_404_everywhere",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/agents/nope/start",
            "json": {}
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/nope/stop"
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents/nope/recreate-worktree"
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/agents/nope/pr-preflight"
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        },
        {
          "http": {
            "method": "DELETE",
            "path": "/agents/nope"
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        },
        {
          "http": {
            "method": "PATCH",
            "path": "/agents/nope/window",
            "json": {
              "x": 1
            }
          },
          "expect": {
            "status": 404,
            "json": {
              "detail": "unknown agent: nope"
            }
          }
        }
      ]
    },
    {
      "id": "an_agent_works_in_its_tabs_worktree_and_can_be_deleted",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "First Task!",
              "kind": "shell",
              "context": "line one\nline two",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.id",
                "equals": "first-task"
              },
              {
                "path": "$.branch",
                "equals": "wt-1"
              },
              {
                "path": "$.status",
                "equals": "stopped"
              },
              {
                "path": "$.kind",
                "equals": "shell"
              },
              {
                "path": "$.context",
                "equals": "line one line two"
              },
              {
                "path": "$.context_kind",
                "equals": "view"
              },
              {
                "path": "$.shares_workspace_with",
                "equals": "{{ws}}"
              },
              {
                "path": "$.worktree_lost",
                "equals": false
              },
              {
                "path": "$.workspace",
                "equals": "{{ws}}"
              },
              {
                "path": "$.worktree",
                "equals": "{{wt}}"
              },
              {
                "path": "$.base_branch",
                "equals": "wt-1"
              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/agents"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.agents",
                "count": 1
              }
            ]
          }
        },
        {
          "http": {
            "method": "DELETE",
            "path": "/agents/first-task"
          },
          "expect": {
            "status": 200,
            "json": {
              "status": "deleted",
              "id": "first-task"
            }
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/agents"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.agents",
                "count": 0
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_drawing_agent_keeps_its_type_and_request",
      "steps": [
        {
          "http": {
            "method": "POST",
            "path": "/branches/ensure"
          },
          "capture": {
            "ws": "$.active",
            "wt": "$.branches[0].worktree"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "http": {
            "method": "POST",
            "path": "/agents",
            "json": {
              "title": "Sketch",
              "kind": "shell",
              "context": "Draw it",
              "context_kind": "task",
              "diagram_type": "sequence",
              "diagram_request": "  how a save\nreaches the db  ",
              "workspace": "{{ws}}"
            }
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.diagram_type",
                "equals": "sequence"
              },
              {
                "path": "$.diagram_request",
                "equals": "how a save reaches the db"
              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/agents"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.agents[0].diagram_type",
                "equals": "sequence"
              },
              {
                "path": "$.agents[0].diagram_request",
                "equals": "how a save reaches the db"
              }
            ]
          }
        },
        {
          "http": {
            "method": "DELETE",
            "path": "/agents/sketch"
          },
          "expect": {
            "status": 200,
            "json": {
              "status": "deleted",
              "id": "sketch"
            }
          }
        }
      ]
    },
