{
  "group": "branches",
  "sources": ["src/codechroma/bridge/routes/branches.py", "src/codechroma/bridge/branches/manager.py"],
  "repo": {"base": "sample_repo"},
  "cases": [
    {
      "id": "no_worktree_tabs_are_open_at_first",
      "steps": [
        {"http": {"method": "GET", "path": "/branches"}, "expect": {"status": 200, "checks": [{"path": "$.branches", "count": 0}, {"path": "$.active", "equals": null}]}}
      ]
    },
    {
      "id": "ensure_creates_wt_1_on_an_empty_project_and_is_a_no_op_afterwards",
      "steps": [
        {
          "http": {"method": "POST", "path": "/branches/ensure"},
          "expect": {"status": 200, "checks": [
            {"path": "$.branches", "count": 1},
            {"path": "$.branches[0].id", "equals": "br_wt-1"},
            {"path": "$.branches[0].name", "equals": "wt-1"},
            {"path": "$.branches[0].branch", "equals": "wt-1"},
            {"path": "$.branches[0].dirty", "equals": 0},
            {"path": "$.branches[0].worktree_lost", "equals": false},
            {"path": "$.active", "equals": "br_wt-1"}
          ]}
        },
        {
          "http": {"method": "POST", "path": "/branches/ensure"},
          "expect": {"status": 200, "checks": [{"path": "$.branches", "count": 1}, {"path": "$.active", "equals": "br_wt-1"}]}
        },
        {
          "http": {"method": "GET", "path": "/branches"},
          "expect": {"status": 200, "checks": [{"path": "$.branches", "count": 1}, {"path": "$.active", "equals": "br_wt-1"}]}
        }
      ]
    },
    {
      "id": "new_twice_gives_wt_1_then_wt_2_without_a_remote",
      "steps": [
        {
          "http": {"method": "POST", "path": "/branches/new", "json": {}},
          "expect": {"status": 200, "checks": [
            {"path": "$.branch.id", "equals": "br_wt-1"},
            {"path": "$.branch.branch", "equals": "wt-1"},
            {"path": "$.branch.worktree", "type": "string"},
            {"path": "$.fetched", "equals": false}
          ]}
        },
        {
          "http": {"method": "POST", "path": "/branches/new"},
          "expect": {"status": 200, "checks": [
            {"path": "$.branch.id", "equals": "br_wt-2"},
            {"path": "$.branch.name", "equals": "wt-2"},
            {"path": "$.fetched", "equals": false}
          ]}
        },
        {
          "http": {"method": "GET", "path": "/branches"},
          "expect": {"status": 200, "checks": [{"path": "$.branches", "count": 2}, {"path": "$.active", "equals": "br_wt-2"}]}
        }
      ]
    },
    {
      "id": "a_new_tab_with_a_bad_name_is_refused",
      "steps": [
        {"http": {"method": "POST", "path": "/branches/new", "json": {"name": 5}}, "expect": {"status": 400, "json": {"detail": "name must be a string"}}},
        {"http": {"method": "POST", "path": "/branches/new", "json": {"name": "bad name"}}, "expect": {"status": 409, "json": {"detail": "'bad name' is not a valid branch name"}}}
      ]
    },
    {
      "id": "rename_changes_the_name_and_branch_but_not_the_id_and_a_duplicate_is_a_409",
      "steps": [
        {"http": {"method": "POST", "path": "/branches/new", "json": {}}, "expect": {"status": 200}},
        {"http": {"method": "POST", "path": "/branches/new", "json": {}}, "expect": {"status": 200}},
        {
          "http": {"method": "PATCH", "path": "/branches/br_wt-1", "json": {"name": "feature/login"}},
          "expect": {"status": 200, "checks": [
            {"path": "$.id", "equals": "br_wt-1"},
            {"path": "$.name", "equals": "feature/login"},
            {"path": "$.branch", "equals": "feature/login"}
          ]}
        },
        {"http": {"method": "PATCH", "path": "/branches/br_wt-2", "json": {"name": "feature/login"}}, "expect": {"status": 409}},
        {"http": {"method": "PATCH", "path": "/branches/br_wt-2", "json": {"name": "wt-2"}}, "expect": {"status": 200, "checks": [{"path": "$.name", "equals": "wt-2"}]}},
        {"http": {"method": "PATCH", "path": "/branches/br_wt-2", "json": {"name": ""}}, "expect": {"status": 400, "json": {"detail": "name is required"}}},
        {"http": {"method": "PATCH", "path": "/branches/br_nope", "json": {"name": "x"}}, "expect": {"status": 404}}
      ]
    },
    {
      "id": "the_active_tab_is_remembered",
      "steps": [
        {"http": {"method": "POST", "path": "/branches/new", "json": {}}, "expect": {"status": 200}},
        {"http": {"method": "POST", "path": "/branches/new", "json": {}}, "expect": {"status": 200}},
        {"http": {"method": "PUT", "path": "/branches/active", "json": {"id": "br_wt-1"}}, "expect": {"status": 200}},
        {"http": {"method": "GET", "path": "/branches"}, "expect": {"status": 200, "checks": [{"path": "$.active", "equals": "br_wt-1"}]}},
        {"http": {"method": "PUT", "path": "/branches/active", "json": {"id": "br_nope"}}, "expect": {"status": 404}},
        {"http": {"method": "PUT", "path": "/branches/active", "json": {}}, "expect": {"status": 400}}
      ]
    },
    {
      "id": "delete_with_a_dirty_tree_succeeds_and_reports_the_dirt_beforehand",
      "steps": [
        {"http": {"method": "POST", "path": "/branches/new", "json": {}}, "expect": {"status": 200}},
        {"fs": "write", "path": ".codechroma/worktrees/br_wt-1/dirty.txt", "text": "uncommitted"},
        {"http": {"method": "GET", "path": "/branches"}, "expect": {"status": 200, "checks": [{"path": "$.branches[0].dirty", "equals": 1}]}},
        {"http": {"method": "DELETE", "path": "/branches/br_wt-1", "query": {"worktree_too": "true"}}, "expect": {"status": 200, "json": {"status": "deleted", "id": "br_wt-1"}}},
        {"http": {"method": "GET", "path": "/branches"}, "expect": {"status": 200, "checks": [{"path": "$.branches", "count": 0}]}}
      ]
    },
    {
      "id": "deleting_a_tab_also_removes_the_agents_attached_to_it",
      "steps": [
        {"http": {"method": "POST", "path": "/branches/ensure"}, "capture": {"ws": "$.active"}, "expect": {"status": 200}},
        {"http": {"method": "POST", "path": "/agents", "json": {"title": "Helper", "kind": "shell", "workspace": "{{ws}}"}}, "expect": {"status": 200}},
        {"http": {"method": "DELETE", "path": "/branches/{{ws}}"}, "expect": {"status": 200}},
        {"http": {"method": "GET", "path": "/agents"}, "expect": {"status": 200, "checks": [{"path": "$.agents", "count": 0}]}}
      ]
    },
    {
      "id": "closing_an_unknown_worktree_tab_is_a_404",
      "steps": [
        {"http": {"method": "DELETE", "path": "/branches/br_nope"}, "expect": {"status": 404}}
      ]
    }
  ]
}
