{
  "group": "diagrams_resolved",
  "sources": ["src/codechroma/bridge/diagram_resolver.py", "src/codechroma/bridge/diagram_migration.py", "src/codechroma/bridge/coverage.py", "src/codechroma/bridge/routes/diagrams.py"],
  "repo": {"base": "sample_repo"},
  "cases": [
    {
      "id": "a_feature_plan_resolves_paths_and_drops_bad_relations_with_diagnostics",
      "requires": ["diagram-resolver"],
      "steps": [
        {"fs": "write", "path": ".codechroma/diagrams/feature-plan/token-auth/token-auth.json", "text": "{\"nodes\": [{\"id\": \"a\", \"name\": \"A\", \"path\": \"shared\"}, {\"id\": \"b\", \"name\": \"B\", \"parent\": \"nope\"}, {\"id\": \"a\", \"name\": \"dup\"}, 7], \"relations\": [{\"from\": \"a\", \"to\": \"b\", \"label\": \"x\"}, {\"from\": \"a\", \"to\": \"a\"}, {\"from\": \"a\", \"to\": \"zz\"}, \"junk\"]}"},
        {
          "http": {"method": "GET", "path": "/repos/main/feature-plan/token-auth"},
          "expect": {"status": 200, "checks": [
            {"path": "$.has_diagram", "equals": true},
            {"path": "$.nodes", "count": 2},
            {"path": "$.nodes[0].node_id", "equals": "dir::shared"},
            {"path": "$.nodes[1].node_id", "absent": true},
            {"path": "$.nodes[1].meta.no_code_reason", "equals": "conceptual"},
            {"path": "$.nodes[1].parent", "type": "null"},
            {"path": "$.relations", "count": 1},
            {"path": "$.relations[0].style", "type": "null"},
            {"path": "$.groups", "count": 0},
            {"path": "$.diagnostics.dropped_count", "equals": 6},
            {"path": "$.diagnostics.dropped[*].reason", "equals": ["duplicate_sibling_id", "invalid_shape", "dangling_endpoint", "self_relation", "dangling_endpoint", "invalid_shape"]}
          ]}
        }
      ]
    },
    {
      "id": "a_plan_diagram_advises_edge_kinds_without_dropping_relations",
      "requires": ["diagram-resolver"],
      "steps": [
        {"fs": "write", "path": ".codechroma/diagrams/feature-plan/edge-kinds/edge-kinds.json", "text": "{\"nodes\": [{\"id\": \"a\", \"name\": \"A\"}, {\"id\": \"b\", \"name\": \"B\"}], \"relations\": [{\"from\": \"a\", \"to\": \"b\", \"kind\": \"bogus\"}, {\"from\": \"a\", \"to\": \"b\", \"label\": \"spawns a worker process\"}, {\"from\": \"b\", \"to\": \"a\", \"label\": \"writes to the sqlite store\"}, {\"from\": \"a\", \"to\": \"b\", \"label\": \"asks\", \"kind\": \"minor\"}]}"},
        {
          "http": {"method": "GET", "path": "/repos/main/feature-plan/edge-kinds"},
          "expect": {"status": 200, "checks": [
            {"path": "$.relations", "count": 4},
            {"path": "$.diagnostics.dropped_count", "equals": 3},
            {"path": "$.diagnostics.dropped[*].reason", "equals": ["bad_edge_kind", "edge_kind_spawn", "edge_kind_data"]}
          ]}
        }
      ]
    },
    {
      "id": "a_sequence_advises_message_kinds_and_skips_edge_kinds",
      "requires": ["diagram-resolver"],
      "steps": [
        {"fs": "write", "path": ".codechroma/diagrams/sequence/sequence.json", "text": "{\"nodes\": [{\"id\": \"p1\", \"name\": \"P1\"}, {\"id\": \"p2\", \"name\": \"P2\"}], \"relations\": [{\"id\": \"m1\", \"from\": \"p1\", \"to\": \"p2\", \"label\": \"login\", \"kind\": \"shout\"}, {\"id\": \"m2\", \"from\": \"p2\", \"to\": \"p1\", \"label\": \"request failed\"}, {\"id\": \"m3\", \"from\": \"p1\", \"to\": \"p2\", \"label\": \"spawns a worker process\"}]}"},
        {
          "http": {"method": "GET", "path": "/repos/main/sequence"},
          "expect": {"status": 200, "checks": [
            {"path": "$.diagnostics.dropped_count", "equals": 2},
            {"path": "$.diagnostics.dropped[*].reason", "equals": ["bad_message_kind", "failure_kind"]}
          ]}
        }
      ]
    },
    {
      "id": "a_missing_feature_plan_is_empty_but_well_formed",
      "requires": ["diagram-resolver"],
      "steps": [
        {
          "http": {"method": "GET", "path": "/repos/main/feature-plan/none-yet"},
          "expect": {"status": 200, "checks": [
            {"path": "$.has_diagram", "equals": false},
            {"path": "$.nodes", "count": 0},
            {"path": "$.diagnostics.dropped_count", "equals": 0}
          ]}
        }
      ]
    },
    {
      "id": "a_custom_diagram_carries_groups_staleness_and_coverage",
      "requires": ["diagram-resolver"],
      "steps": [
        {"http": {"method": "PUT", "path": "/diagram-types/flow", "json": {"title": "Flow", "style": "boxes-arrows", "instructions": "x", "layout": {"direction": "TB"}, "grouping": {"enabled": true}, "relation_kinds": []}}, "expect": {"status": 200}},
        {"fs": "write", "path": ".codechroma/diagrams/custom/flow/flow.json", "text": "{\"fingerprint\": \"old\", \"nodes\": [{\"id\": \"a\", \"name\": \"A\", \"group\": \"zeta\"}, {\"id\": \"b\", \"name\": \"B\", \"group\": \"alpha\", \"path\": \"web\"}, {\"id\": \"c\", \"name\": \"C\"}], \"relations\": []}"},
        {
          "http": {"method": "GET", "path": "/repos/main/custom/flow"},
          "expect": {"status": 200, "checks": [
            {"path": "$.groups", "equals": ["alpha", "zeta"]},
            {"path": "$.has_diagram", "equals": true},
            {"path": "$.fingerprint", "type": "string"},
            {"path": "$.reviewed_fingerprint", "equals": "old"},
            {"path": "$.stale", "equals": true},
            {"path": "$.unmapped[*].path", "equals": ["billing", "shared", "users"]}
          ]}
        },
        {
          "http": {"method": "GET", "path": "/repos/main/custom/flow/context"},
          "expect": {"status": 200, "json": {"coverage": null, "staleness": null, "generation_data": null}}
        }
      ]
    },
    {
      "id": "a_legacy_nested_c1_is_converted_to_the_flat_shape_in_place",
      "requires": ["diagram-resolver"],
      "steps": [
        {"fs": "write", "path": ".codechroma/diagrams/c1/c1.json", "text": "{\"system\": {\"name\": \"Sample\", \"description\": \"d\", \"children\": [{\"id\": \"web\", \"name\": \"Web\", \"path\": \"web\"}, {\"id\": \"web\", \"name\": \"Web again\"}]}, \"actors\": [{\"id\": \"user\", \"name\": \"User\", \"type\": \"person\"}], \"relationships\": [{\"from\": \"user\", \"to\": \"system\", \"label\": \"uses\"}, {\"from\": \"ghost\", \"to\": \"system\"}]}"},
        {
          "http": {"method": "GET", "path": "/repos/main/c1"},
          "expect": {"status": 200, "checks": [
            {"path": "$.type", "equals": "c1"},
            {"path": "$.nodes[*].id", "equals": ["system", "web", "web-2", "user"]},
            {"path": "$.nodes[1].node_id", "equals": "dir::web"},
            {"path": "$.nodes[3].kind", "equals": "person"},
            {"path": "$.relations", "count": 1},
            {"path": "$.needs_regeneration", "absent": true}
          ]}
        },
        {
          "http": {"method": "GET", "path": "/repos/main/c1"},
          "expect": {"status": 200, "checks": [{"path": "$.nodes", "count": 4}]}
        }
      ]
    },
    {
      "id": "epics_and_sequence_resolve_only_what_was_authored",
      "requires": ["diagram-resolver"],
      "steps": [
        {"http": {"method": "GET", "path": "/repos/main/epics"}, "expect": {"status": 200, "checks": [{"path": "$.has_diagram", "equals": false}, {"path": "$.nodes", "count": 0}]}},
        {"http": {"method": "GET", "path": "/repos/main/sequence"}, "expect": {"status": 200, "json": {}}},
        {"fs": "write", "path": ".codechroma/diagrams/sequence/sequence.json", "text": "{\"nodes\": [{\"id\": \"p1\", \"name\": \"P1\"}, {\"id\": \"p2\", \"name\": \"P2\"}], \"relations\": [{\"from\": \"p1\", \"to\": \"p1\", \"label\": \"self\"}, {\"from\": \"p1\", \"to\": \"p2\", \"label\": \"call\"}]}"},
        {"http": {"method": "GET", "path": "/repos/main/sequence"}, "expect": {"status": 200, "checks": [
          {"path": "$.type", "equals": "sequence"}, {"path": "$.has_diagram", "equals": true}, {"path": "$.relations", "count": 2}, {"path": "$.groups", "count": 0}
        ]}}
      ]
    },
    {
      "id": "a_custom_diagram_written_to_disk_pings_connected_canvases",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "write", "path": ".codechroma/diagrams/custom/dataflow/dataflow.json", "text": "{\"nodes\": [{\"id\": \"a\", \"name\": \"A\"}], \"relations\": []}"},
        {"ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true, "expect": {"json": {"type": "custom"}}}
      ]
    },
    {
      "id": "a_route_resolves_node_ids_to_path_and_line_with_soft_diagnostics",
      "requires": [
        "diagram-resolver"
      ],
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/feature-plan/route-demo/route-demo.json",
          "text": "{\"nodes\": [{\"id\": \"s1\", \"name\": \"Create\"}], \"relations\": [], \"route\": {\"id\": \"r1\", \"title\": \"t\", \"steps\": [{\"id\": \"s1\", \"order\": 1, \"title\": \"Create\", \"kind\": \"decide\", \"node_ids\": [\"billing/service.py::function::BillingService.create_invoice\", \"component::billing/service.py\", \"nope::id\"], \"children\": [{\"id\": \"c1\", \"label\": \"a\", \"line\": 99, \"node_id\": \"billing/service.py::function::BillingService.create_invoice\"}, {\"id\": \"c2\", \"label\": \"b\", \"line\": 8, \"node_id\": \"billing/service.py::function::BillingService.__init__\"}, {\"id\": \"c3\", \"label\": \"c\", \"line\": 3, \"node_id\": \"ghost::fn\"}]}]}}"
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/feature-plan/route-demo"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.route.steps[0].resolved",
                "count": 2
              },
              {
                "path": "$.route.summary",
                "equals": "1 steps · 1 files · 0 AI steps"
              },
              {
                "path": "$.route.steps[0].resolved[0].line",
                "equals": 11
              },
              {
                "path": "$.route.steps[0].resolved[0].path",
                "equals": "billing/service.py"
              },
              {
                "path": "$.route.steps[0].resolved[1].line",
                "absent": true
              },
              {
                "path": "$.route.steps[0].children[0].line_mismatch",
                "equals": true
              },
              {
                "path": "$.route.steps[0].children[0].resolved_line",
                "equals": 11
              },
              {
                "path": "$.route.steps[0].children[1].line_mismatch",
                "absent": true
              },
              {
                "path": "$.route.steps[0].children[2].path",
                "absent": true
              },
              {
                "path": "$.diagnostics.dropped_count",
                "equals": 2
              },
              {
                "path": "$.diagnostics.dropped[*].reason",
                "equals": [
                  "unresolved_path",
                  "unresolved_path"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_route_summary_counts_only_object_steps",
      "requires": [
        "diagram-resolver"
      ],
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/feature-plan/route-oops/route-oops.json",
          "text": "{\"nodes\": [{\"id\": \"s1\", \"name\": \"Create\"}], \"relations\": [], \"route\": {\"id\": \"r1\", \"title\": \"t\", \"steps\": [{\"id\": \"s1\", \"order\": 1, \"title\": \"Create\", \"kind\": \"decide\", \"node_ids\": [\"billing/service.py::function::BillingService.create_invoice\"], \"children\": []}, \"oops\"]}}"
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/feature-plan/route-oops"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.route.summary",
                "equals": "1 steps · 1 files · 0 AI steps"
              }
            ]
          }
        }
      ]
    }
  ]
}
