    {
      "id": "accepting_a_function_with_no_hunk_of_its_own_commits_the_whole_file",
      "requires": [
        "real-engine"
      ],
      "steps": [
        {
          "fs": "replace",
          "path": "billing/models/invoice.py",
          "find": "return f\"INV-{number:06d}\"",
          "with": "return \"PATCHED\""
        },
        {
          "http": {
            "method": "POST",
            "path": "/repos/main/diff/billing/models/invoice.py::function::Invoice.total/accept"
          },
          "expect": {
            "status": 200,
            "json": {
              "status": "committed",
              "file_path": "billing/models/invoice.py",
              "commit_sha": {
                "$any": true
              }
            }
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/diff"
          },
          "expect": {
            "status": 200,
            "json": []
          }
        }
      ]
    }
  ]
}
