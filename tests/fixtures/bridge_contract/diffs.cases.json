    {
      "id": "accepting_one_function_commits_only_that_function",
      "requires": [
        "real-engine"
      ],
      "steps": [
        {
          "fs": "replace",
          "path": "billing/models/invoice.py",
          "find": "return sum(line[\"amount\"] for line in lines)",
