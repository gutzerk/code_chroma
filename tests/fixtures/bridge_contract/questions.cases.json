  "cases": [
    {
      "id": "an_open_question_is_listed_as_not_waiting_without_a_live_agent",
      "steps": [
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/questions"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.questions",
                "count": 0
              }
            ]
          }
        },
        {
          "http": {
            "method": "PATCH",
            "path": "/repos/main/canvas",
            "json": {
              "ops": [
                {
                  "op": "add_element",
                  "temp_id": "q",
                  "render": "question",
                  "layer": "questions",
                  "label": "Pick one?",
                  "meta": {
                    "question_id": "q1",
                    "session_id": null,
                    "step": 1,
                    "total": 2,
                    "kind": "choices",
                    "state": "open",
                    "answer": null,
                    "option_id": null,
                    "allow_custom": true,
                    "allow_skip": true,
                    "agent_id": "main",
                    "options": [
                      {
                        "id": "a",
                        "title": "Modular monolith",
                        "description": "d",
                        "pro": "p",
                        "con": "c",
                        "why": "w",
                        "rank": 1
                      },
                      {
                        "id": "b",
                        "title": "Microservices",
                        "description": "d",
                        "pro": "p",
                        "con": "c",
                        "why": "w",
                        "rank": 2
                      }
                    ]
                  }
                }
              ]
            }
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.ok",
                "equals": true
              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/questions"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.questions",
                "count": 1
              },
              {
                "path": "$.questions[0].question_id",
                "equals": "q1"
              },
              {
                "path": "$.questions[0].question",
                "equals": "Pick one?"
              },
              {
                "path": "$.questions[0].waiting",
                "equals": false
              },
              {
                "path": "$.questions[0].state",
                "equals": "open"
              },
              {
                "path": "$.questions[0].options",
                "count": 2
              }
            ]
          }
        }
      ]
    },
