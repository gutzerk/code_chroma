                "equals": true
              },
              {
                "path": "$.diagnostics.dropped_count",
                "equals": 1
              },
              {
                "path": "$.diagnostics.dropped..reason",
                "equals": [
                  "dangling_endpoint"
                ]
              }
            ]
          }
        }
      ]
    },
