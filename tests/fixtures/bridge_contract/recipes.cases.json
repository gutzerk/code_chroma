              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/canvas"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.elements",
                "count": 0
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_sequence_message_carries_kind_and_failure_into_its_element_meta",
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/sequence/sequence.json",
          "text": "{\"nodes\": [{\"id\": \"a\", \"name\": \"A\"}, {\"id\": \"b\", \"name\": \"B\"}], \"relations\": [{\"id\": \"m1\", \"from\": \"a\", \"to\": \"b\", \"label\": \"login\", \"order\": \"1\", \"kind\": \"call\"}, {\"id\": \"m2\", \"from\": \"b\", \"to\": \"a\", \"label\": \"denied\", \"order\": \"2\", \"kind\": \"error\", \"failure\": true}]}"
        },
        {
          "http": {
            "method": "POST",
            "path": "/repos/main/recipes/sequence/run"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.ok",
                "equals": true
              }
            ]
          },
          "capture": {
            "call": "$.id_map.n2",
            "fail": "$.id_map.n3"
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/canvas"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.elements['{{call}}'].meta.kind",
                "equals": "call"
              },
              {
                "path": "$.elements['{{fail}}'].meta.kind",
                "equals": "error"
              },
              {
                "path": "$.elements['{{fail}}'].meta.failure",
                "equals": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "an_authored_edge_kind_and_transport_survive_into_the_canvas_edge",
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/impact/impact.json",
          "text": "{\"nodes\": [{\"id\": \"a\", \"name\": \"A\", \"node_id\": \"component::src\"}, {\"id\": \"b\", \"name\": \"B\", \"node_id\": \"component::src\"}, {\"id\": \"c\", \"name\": \"C\", \"node_id\": \"component::src\"}, {\"id\": \"d\", \"name\": \"D\", \"node_id\": \"component::src\"}], \"relations\": [{\"from\": \"a\", \"to\": \"b\", \"label\": \"launches\", \"kind\": \"spawns\"}, {\"from\": \"a\", \"to\": \"c\", \"label\": \"writes cache\", \"kind\": \"data\", \"transport\": \"file\"}, {\"from\": \"a\", \"to\": \"d\", \"label\": \"plain\"}]}"
        },
        {
          "http": {
            "method": "POST",
            "path": "/repos/main/recipes/impact/run"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.ok",
                "equals": true
              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/canvas"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.edges",
                "count": 3
              },
              {
                "path": "$.edges..kind",
                "contains": "spawns"
              },
              {
                "path": "$.edges..kind",
                "contains": "data"
              },
              {
                "path": "$.edges..kind",
                "contains": "uses"
              },
              {
                "path": "$.edges..transport",
                "contains": "file"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_route_rides_once_on_a_carrier_element_and_nodes_carry_only_their_step",
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/impact/impact.json",
          "text": "{\"nodes\": [{\"id\": \"n1\", \"name\": \"Click Update\", \"node_id\": \"component::src\"}, {\"id\": \"n2\", \"name\": \"Rewrite pages\"}], \"relations\": [{\"from\": \"n1\", \"to\": \"n2\", \"label\": \"then\"}], \"route\": {\"id\": \"r1\", \"title\": \"Update the map\", \"steps\": [{\"id\": \"n1\", \"order\": 1, \"lane\": \"you\", \"title\": \"Click Update\", \"kind\": \"trigger\", \"node_ids\": [\"component::src\"], \"children\": [{\"id\": \"c1\", \"label\": \"Run()\", \"node_id\": \"component::src\", \"line\": 12}]}, {\"id\": \"n2\", \"order\": 2, \"lane\": \"claude\", \"title\": \"Rewrite pages\", \"kind\": \"ai\", \"node_ids\": [\"component::src\"], \"children\": []}]}}"
        },
        {
          "http": {
            "method": "POST",
            "path": "/repos/main/recipes/impact/run"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.ok",
                "equals": true
              }
            ]
          },
          "capture": {
            "first": "$.id_map.n0"
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/canvas"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.elements..route",
                "count": 1
              },
              {
                "path": "$.elements..route.summary",
                "equals": ["2 steps · 1 files · 1 AI steps"]
              },
              {
                "path": "$.elements['{{first}}'].meta.route_id",
                "equals": "r1"
              },
              {
                "path": "$.elements['{{first}}'].meta.route",
                "absent": true
              },
              {
                "path": "$.elements['{{first}}'].meta.route_step.kind",
                "equals": "trigger"
              },
              {
                "path": "$.elements['{{first}}'].meta.route_step.children[0].line",
                "equals": 12
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_lane_of_only_failure_steps_is_stamped_lane_kind_failure",
      "steps": [
        {
          "fs": "write",
          "path": ".codechroma/diagrams/impact/impact.json",
          "text": "{\"nodes\": [{\"id\": \"n1\", \"name\": \"Click\", \"node_id\": \"component::src\"}, {\"id\": \"n2\", \"name\": \"Retry\", \"node_id\": \"component::src\"}, {\"id\": \"n3\", \"name\": \"Boom\", \"node_id\": \"component::src\"}], \"relations\": [{\"from\": \"n1\", \"to\": \"n2\", \"label\": \"then\"}, {\"from\": \"n2\", \"to\": \"n3\", \"label\": \"fails\"}], \"route\": {\"id\": \"r1\", \"title\": \"T\", \"steps\": [{\"id\": \"n1\", \"order\": 1, \"lane\": \"flow\", \"title\": \"Click\", \"kind\": \"trigger\", \"node_ids\": [], \"children\": []}, {\"id\": \"n2\", \"order\": 2, \"lane\": \"Failures\", \"title\": \"Retry\", \"kind\": \"decide\", \"node_ids\": [], \"children\": []}, {\"id\": \"n3\", \"order\": 3, \"lane\": \"Errors\", \"title\": \"Boom\", \"kind\": \"failure\", \"node_ids\": [], \"children\": []}]}}"
        },
        {
          "http": {
            "method": "POST",
            "path": "/repos/main/recipes/impact/run"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$.ok",
                "equals": true
              }
            ]
          }
        },
        {
          "http": {
            "method": "GET",
            "path": "/repos/main/canvas"
          },
          "expect": {
            "status": 200,
            "checks": [
              {
                "path": "$..lane_kind",
                "equals": [
                  "normal",
                  "normal",
                  "failure"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a_diagram_title_rides_on_every_element_meta",
      "steps": [
        {"fs": "write", "path": ".codechroma/diagrams/${kind}/${kind}.json", "text": "{\"title\": \"How a login reaches the store\", \"nodes\": [{\"id\": \"a\", \"name\": \"A\", \"kind\": \"external\", \"node_id\": \"component::src\"}, {\"id\": \"b\", \"name\": \"B\", \"kind\": \"external\", \"node_id\": \"component::src\"}], \"relations\": [{\"id\": \"m1\", \"from\": \"a\", \"to\": \"b\", \"label\": \"calls\", \"order\": \"1\"}]}"},
        {"http": {"method": "POST", "path": "/repos/main/recipes/${kind}/run"}, "expect": {"status": 200, "checks": [{"path": "$.ok", "equals": true}]}},
        {"http": {"method": "GET", "path": "/repos/main/canvas"}, "expect": {"status": 200, "checks": [
          {"path": "$.elements..meta.diagram_title", "contains": "How a login reaches the store"}
        ]}}
      ],
      "matrix": {"kind": ["system-context", "patterns", "impact", "sequence", "walkthrough"]}
    }
  ]
}
