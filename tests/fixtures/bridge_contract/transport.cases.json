{
  "group": "transport",
  "sources": [
    "tests/unit/test_bridge_origin_guard.py",
    "tests/unit/test_bridge_events_route.py",
    "tests/unit/test_bridge_terminal_route.py",
    "tests/unit/test_terminal_server.py"
  ],
  "repo": {"base": "sample_repo"},
  "cases": [
    {
      "id": "health_reports_the_analyzed_root",
      "steps": [
        {
          "http": {"method": "GET", "path": "/health"},
          "expect": {"status": 200, "json": {"status": "ok", "repo": "$REPO"}}
        }
      ]
    },
    {
      "id": "a_cross_origin_unsafe_request_is_refused_before_routing",
      "steps": [
        {
          "http": {"method": "${method}", "path": "/workspaces/nobody/activate",
                   "headers": {"origin": "https://evil.example"}},
          "expect": {"status": 403, "json": {"detail": "cross-origin request refused"}}
        }
      ],
      "matrix": {"method": ["POST", "PUT", "PATCH", "DELETE"]}
    },
    {
      "id": "a_request_without_an_origin_passes_the_guard",
      "steps": [
        {"http": {"method": "POST", "path": "/workspaces/nobody/activate"}, "expect": {"status": 404}}
      ]
    },
    {
      "id": "an_allowed_or_own_loopback_origin_passes_the_guard",
      "steps": [
        {
          "http": {"method": "POST", "path": "/workspaces/nobody/activate",
                   "headers": {"origin": "${origin}", "host": "127.0.0.1:8000"}},
          "expect": {"status": 404}
        }
      ],
      "matrix": {"origin": ["http://127.0.0.1:8000", "http://localhost:5173", "http://127.0.0.1:5173"]}
    },
    {
      "id": "a_rebound_host_matching_its_own_origin_is_refused",
      "steps": [
        {
          "http": {"method": "POST", "path": "/workspaces/nobody/activate",
                   "headers": {"origin": "http://evil.example", "host": "evil.example"}},
          "expect": {"status": 403}
        }
      ]
    },
    {
      "id": "a_cross_origin_read_is_not_blocked",
      "steps": [
        {"http": {"method": "GET", "path": "/health", "headers": {"origin": "https://evil.example"}}, "expect": {"status": 200}}
      ]
    },
    {
      "id": "a_cross_origin_websocket_handshake_is_refused",
      "steps": [
        {"ws": "connect", "name": "events", "path": "${path}", "headers": {"origin": "https://evil.example"}, "expect": "rejected"}
      ],
      "matrix": {"path": ["/repos/main/events", "/ws/terminal?agent=shell"]}
    },
    {
      "id": "a_repo_change_is_reanalyzed_and_pings_the_canvas",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "replace", "path": "shared/text_utils.py", "find": "return text.strip().lower().replace(\" \", \"-\")", "with": "return \"patched\""},
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"checks": [
            {"path": "$.type", "equals": "changed"},
            {"path": "$.paths", "contains": "shared/text_utils.py"}
          ]}
        }
      ]
    },
    {
      "id": "a_diagram_file_change_pings_only_its_kind",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "write", "path": ".codechroma/diagrams/c1/c1.json", "text": "{\"system\": {\"name\": \"X\", \"description\": \"\"}, \"actors\": [], \"relationships\": []}"},
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"json": {"type": "c1"}}
        }
      ]
    },
    {
      "id": "an_impact_changes_file_change_pings_impact_changes",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "write", "path": ".codechroma/impact-changes.json", "text": "{}"},
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"json": {"type": "impact-changes"}}
        }
      ]
    },
    {
      "id": "a_wiki_general_index_change_pings_wiki_general",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "write", "path": ".codechroma/wiki-general/index.md", "text": "# Map\n"},
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"json": {"type": "wiki-general"}}
        }
      ]
    },
    {
      "id": "a_custom_projection_change_pings_custom_and_canvas",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/main/events", "expect": "accepted"},
        {"fs": "write", "path": ".codechroma/diagrams/custom/flow/projection.json", "text": "{}"},
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"json": {"type": "custom"}}
        },
        {
          "ws": "receive", "name": "events", "timeout_ms": 15000, "skip_until_match": true,
          "expect": {"json": {"type": "canvas"}}
        }
      ]
    },
    {
      "id": "a_status_change_is_broadcast_to_connected_canvases",
      "steps": [
        {"ws": "connect", "name": "events", "path": "/repos/default/events", "expect": "accepted"},
        {"http": {"method": "POST", "path": "/repos/default/c1/status", "json": {"state": "generating"}}, "expect": {"status": 200}},
        {
          "ws": "receive", "name": "events", "timeout_ms": 8000,
          "expect": {"json": {"type": "c1-status", "state": "generating", "error": null}}
        }
      ]
    },
    {
      "id": "terminal_rejects_an_unknown_agent_with_a_tagged_error_frame",
      "requires": ["terminal-frames"],
      "steps": [
        {"ws": "connect", "name": "term", "path": "/ws/terminal?agent=bogus", "expect": "accepted"},
        {
          "ws": "receive", "name": "term", "tag": "e", "timeout_ms": 8000,
          "expect": {"json": {"type": "error", "message": "unknown agent: bogus"}}
        },
        {"ws": "expect_close", "name": "term", "code": 4404}
      ]
    },
    {
      "id": "terminal_rejects_the_bare_agent_kind_with_no_executable",
      "requires": ["terminal-frames"],
      "steps": [
        {"ws": "connect", "name": "term", "path": "/ws/terminal?agent=agent", "expect": "accepted"},
        {
          "ws": "receive", "name": "term", "tag": "e", "timeout_ms": 8000,
          "expect": {"json": {"type": "error", "message": "no executable configured for agent: agent"}}
        },
        {"ws": "expect_close", "name": "term", "code": 4404}
      ]
    },
    {
      "id": "terminal_pty_output_arrives_in_o_tagged_frames",
      "requires": ["pty"],
      "steps": [
        {"ws": "connect", "name": "term", "path": "/ws/terminal?agent=shell", "expect": "accepted"},
        {"ws": "receive", "name": "term", "tag": "o", "raw": true, "timeout_ms": 15000}
      ]
    }
  ]
}
