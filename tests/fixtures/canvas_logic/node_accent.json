    {"name": "group hash is stable: Storage", "render": "custom", "meta": {"group": "Storage"}, "expected": {"group": 3}},
    {"name": "group hash differs by name: Auth", "render": "custom", "meta": {"group": "Auth"}, "expected": {"group": 0}},
    {"name": "several rules combine", "render": "custom", "meta": {"kind": "flow", "status": "modified"}, "expected": {"kind": "flow", "status": "modified"}},
    {"name": "conceptual no-code box", "render": "custom", "meta": {"no_code_reason": "conceptual"}, "expected": {"noCode": "conceptual"}},
    {"name": "unresolved no-code box", "render": "custom", "meta": {"no_code_reason": "unresolved"}, "expected": {"noCode": "unresolved"}},
    {"name": "external no-code box", "render": "custom", "meta": {"no_code_reason": "external"}, "expected": {"noCode": "external"}},
    {"name": "planned is not a recognised no-code reason", "render": "custom", "meta": {"plan_kind": "add", "no_code_reason": "planned"}, "expected": {}},
