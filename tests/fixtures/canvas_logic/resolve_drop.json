    {"name": "escapes one overlap to the left by the minimum translation", "moving": [150, 25, 100, 50], "obstacles": [["a", 200, 0, 200, 100]], "expected": {"x": 76, "y": 25, "blocked": false}},
    {"name": "escapes upwards by the rank gap when the free space is above", "moving": [250, 170, 100, 50], "obstacles": [["a", 0, 200, 600, 200]], "expected": {"x": 250, "y": 126, "blocked": false}},
    {"name": "finds the nearest point free of both neighbours", "moving": [150, 120, 100, 50], "obstacles": [["a", 0, 0, 200, 100], ["b", 0, 190, 200, 100]], "expected": {"x": 224, "y": 120, "blocked": false}},
